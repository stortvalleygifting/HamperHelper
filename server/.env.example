# Postgres connection string, e.g.:
# postgresql://hamperhelper:changeme@localhost:5432/hamperhelper
DATABASE_URL=

# Port the Express server listens on (defaults to 3000)
PORT=3000

# Where uploaded images and generated/uploaded proposal documents are stored
# on disk (defaults to server/uploads)
UPLOADS_DIR=

# Secret used to sign staff login session cookies. Required — generate one
# with, e.g., `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=

# Set to "production" when running behind HTTPS — makes session cookies
# secure-only and trusts the reverse proxy's X-Forwarded-* headers.
NODE_ENV=
